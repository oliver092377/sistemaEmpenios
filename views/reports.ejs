<%- include('partials/header', {title: 'Flujo de Caja - Sistema de Empeños', currentPage: 'reports'}) %>

<%- include('partials/sidebar', {currentPage: 'reports'}) %>

<div class="main-content">
    <!-- Page Heading -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h1 class="h3 text-gray-800">Reportes</h1>
        <% if (isAdmin) { %>
            <div class="d-flex align-items-center gap-2">
                <label for="yearFilter" class="mb-0 text-muted">Año:</label>
                <select id="yearFilter" class="form-select" style="width: auto;">
                    <option value="">Cargando...</option>
                </select>
            </div>
        <% } %>
    </div>

    <% if (isAdmin) { %>
        <div class="row">
            <div class="col-lg-6">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Ganancias por mes</h6>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="GananciaChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-danger">Pérdidas por mes</h6>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="PerdidaChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Flujo Mensual</h6>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="flowChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="alert alert-warning">
            Solo el usuario administrador puede ver estos reportes.
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>

<%- include('partials/scripts', {currentPage: 'reports'}) %>
    <% if (isAdmin) { %>
        <script src="/js/reports.js"></script>
    <% } %>
</body>
</html>
