<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Gestión de Empeños</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4e73df;
            --secondary: #858796;
            --success: #1cc88a;
            --info: #36b9cc;
            --warning: #f6c23e;
            --danger: #e74a3b;
            --light: #f8f9fc;
            --dark: #5a5c69;
        }

        body {
            background-color: #f8f9fc;
            font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }

        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 48px 0 0;
            box-shadow: 0 0 45px 0 rgba(0, 0, 0, 0.12);
            background: linear-gradient(180deg, var(--primary) 10%, #224abe 100%);
            width: 250px;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
        }

        .sidebar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            padding: 1.5rem 1rem;
            text-align: center;
            color: #fff;
            text-decoration: none;
            display: block;
        }

        .sidebar-divider {
            border-top: 1px solid rgba(255, 255, 255, .15);
            margin: 0 1rem 1rem;
        }

        .nav-item {
            position: relative;
        }

        .nav-link {
            color: rgba(255, 255, 255, .8);
            padding: 1rem;
            display: flex;
            align-items: center;
            transition: all 0.3s;
        }

        .nav-link i {
            margin-right: 0.5rem;
            font-size: 1.2rem;
        }

        .nav-link:hover {
            color: #fff;
            background-color: rgba(255, 255, 255, .1);
        }

        .active {
            color: #fff !important;
            background-color: rgba(255, 255, 255, .1);
        }

        .card {
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            border: none;
            border-radius: 0.35rem;
            margin-bottom: 20px;
        }

        .card-header {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
            padding: 0.75rem 1.25rem;
        }

        .dashboard-card {
            border-left: 0.25rem solid;
        }

        .bg-primary-card {
            border-left-color: var(--primary);
        }

        .bg-success-card {
            border-left-color: var(--success);
        }

        .bg-info-card {
            border-left-color: var(--info);
        }

        .bg-warning-card {
            border-left-color: var(--warning);
        }

        .btn-primary {
            background-color: var(--primary);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background-color: #2e59d9;
            border-color: #2653d4;
        }

        .btn-success {
            background-color: var(--success);
            border-color: var(--success);
        }

        .btn-danger {
            background-color: var(--danger);
            border-color: var(--danger);
        }

        .transaction-table th {
            background-color: #f8f9fc;
            color: var(--dark);
            font-weight: 700;
        }

        .income {
            color: var(--success);
            font-weight: bold;
        }

        .expense {
            color: var(--danger);
            font-weight: bold;
        }

        .capital {
            color: var(--info);
            font-weight: bold;
        }

        .profit {
            color: var(--success);
            font-weight: bold;
        }

        .chart-container {
            position: relative;
            height: 300px;
        }

        .stat-number {
            font-size: 1.5rem;
            font-weight: 700;
        }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <a class="sidebar-brand d-flex align-items-center justify-content-center" href="#">
            <div class="sidebar-brand-icon">
                <i class="fas fa-store"></i>
            </div>
            <div class="sidebar-brand-text mx-3">Negocio Empeños</div>
        </a>

        <hr class="sidebar-divider my-0">

        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link active" href="/dashboard">
                    <i class="fas fa-home"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="#">
                    <i class="fas fa-cash-register"></i>
                    <span>Flujo de Caja</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/empe">
                    <i class="fas fa-gem"></i>
                    <span>Empeños</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="fas fa-percent"></i>
                    <span>Intereses</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="fas fa-chart-bar"></i>
                    <span>Reportes</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="fas fa-cog"></i>
                    <span>Configuración</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Page Heading -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 text-gray-800">Flujo de Caja</h1>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTransactionModal">
                <i class="fas fa-plus me-2"></i>Nueva Transacción
            </button>
        </div>

        <!-- Dashboard Cards -->
        <div class="row">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card dashboard-card bg-primary-card h-100">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-primary text-uppercase mb-1">
                                    Capital Disponible
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800 capital">S/ 12,850.00</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-piggy-bank fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card dashboard-card bg-success-card h-100">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-success text-uppercase mb-1">
                                    Ganancias del Mes
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800 profit">S/ 3,420.00</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-chart-line fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card dashboard-card bg-info-card h-100">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-info text-uppercase mb-1">
                                    Entradas (Mes)
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800 income">S/ 8,750.00</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-arrow-down fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card dashboard-card bg-warning-card h-100">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-warning text-uppercase mb-1">
                                    Salidas (Mes)
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800 expense">S/ 5,330.00</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-arrow-up fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Transaction Form -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">Registrar Transacción</h6>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Tipo de Transacción</label>
                                    <select class="form-select" id="transactionType" name="tipo">
                                        <option value="">Seleccionar...</option>
                                        <option value="entrada">Entrada</option>
                                        <option value="salida">Salida</option>
                                    </select>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Categoría</label>
                                    <select class="form-select" id="transactionCategory" name="categoria">
                                        <option value="">Seleccionar...</option>
                                        <option value="empenio">Recogida de Empeño</option>
                                        <option value="venta">Venta de Producto</option>
                                        <option value="prestamo">Préstamo</option>
                                        <option value="gasto">Gasto Operativo</option>
                                        <option value="otro">Otro</option>
                                    </select>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Monto Total</label>
                                    <input type="number" class="form-control" placeholder="S/ 0.00" step="0.01"
                                        name="monto">
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Monto Ganancia</label>
                                    <input type="number" class="form-control" placeholder="S/ 0.00" step="0.01"
                                        name="ganancia">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Descripción</label>
                                    <textarea class="form-control" rows="2" placeholder="Detalles de la transacción"
                                        name="descripcion"></textarea>
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Fecha</label>
                                    <input type="date" class="form-control" name="fecha">
                                </div>

                                <div class="col-md-3 mb-3 d-flex align-items-end">
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="fas fa-save me-2"></i>Guardar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Transactions Table -->
        <div class="row">
            <div class="col-lg-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary">Historial de Transacciones</h6>
                        <div class="d-flex">
                            <input type="text" class="form-control me-2" placeholder="Buscar...">
                            <select class="form-select me-2" style="width: 150px;">
                                <option>Todas las categorías</option>
                                <option>Recogida de Empeño</option>
                                <option>Préstamo</option>
                                <option>Venta</option>
                                <option>Gasto</option>
                            </select>
                            <button class="btn btn-outline-primary">
                                <i class="fas fa-filter"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered transaction-table">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Descripción</th>
                                        <th>Categoría</th>
                                        <th>Tipo</th>
                                        <th>Monto Total</th>
                                        <th>Ganancia</th>
                                        <th>Capital</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>27/07/2023</td>
                                        <td>Recogio empeño de laptop</td>
                                        <td>Recogida de Empeño</td>
                                        <td><span class="income">Entrada</span></td>
                                        <td class="income">S/ 330.00</td>
                                        <td class="profit">S/ 30.00</td>
                                        <td class="income">S/ 300.00</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>26/07/2023</td>
                                        <td>Préstamo por celular</td>
                                        <td>Préstamo</td>
                                        <td><span class="expense">Salida</span></td>
                                        <td class="expense">S/ 200.00</td>
                                        <td>-</td>
                                        <td class="expense">S/ 200.00</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>25/07/2023</td>
                                        <td>Venta de anillo de oro</td>
                                        <td>Venta</td>
                                        <td><span class="income">Entrada</span></td>
                                        <td class="income">S/ 1,250.00</td>
                                        <td class="profit">S/ 350.00</td>
                                        <td class="capital">S/ 900.00</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>24/07/2023</td>
                                        <td>Pago de alquiler local</td>
                                        <td>Gasto</td>
                                        <td><span class="expense">Salida</span></td>
                                        <td class="expense">S/ 1,500.00</td>
                                        <td>-</td>
                                        <td class="expense">S/ 1,500.00</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>22/07/2023</td>
                                        <td>Recogida de televisor</td>
                                        <td>Recogida de Empeño</td>
                                        <td><span class="income">Entrada</span></td>
                                        <td class="income">S/ 450.00</td>
                                        <td class="profit">S/ 50.00</td>
                                        <td class="capital">S/ 400.00</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <nav>
                            <ul class="pagination justify-content-center">
                                <li class="page-item disabled">
                                    <a class="page-link" href="#" tabindex="-1">Anterior</a>
                                </li>
                                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                <li class="page-item"><a class="page-link" href="#">2</a></li>
                                <li class="page-item"><a class="page-link" href="#">3</a></li>
                                <li class="page-item">
                                    <a class="page-link" href="#">Siguiente</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts -->
        <div class="row">
            <div class="col-lg-6">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Distribución de Capital</h6>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="capitalChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Flujo Mensual</h6>
                    </div>
                    <div class="card-body">
                        <div class="chart-container">
                            <canvas id="flowChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row">
            <div class="col-md-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                    Ganancias Totales
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800 profit">S/ 8,420.00</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                    Capital en Circulación
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800 capital">S/ 32,150.00</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-sync fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                    Saldo Actual
                                </div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">S/ 15,280.00</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-wallet fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Transaction Modal -->
    <div class="modal fade" id="addTransactionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form action="/empenio/guardar-empenio" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Registrar Nueva Transacción</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Tipo de Transacción</label>
                                <select class="form-select" name="tipo" required>
                                    <option value="">Seleccionar...</option>
                                    <option value="entrada">Entrada</option>
                                    <option value="salida">Salida</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Categoría</label>
                                <select class="form-select" name="categoria" required>
                                    <option value="">Seleccionar...</option>
                                    <option value="empenio">Recogida de Empeño</option>
                                    <option value="venta">Venta de Producto</option>
                                    <option value="prestamo">Préstamo</option>
                                    <option value="gasto">Gasto Operativo</option>
                                    <option value="otro">Otro</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Monto Total</label>
                                <input type="number" class="form-control" name="monto" placeholder="S/ 0.00" step="0.01" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Monto Ganancia</label>
                                <input type="number" class="form-control" name="ganancia" placeholder="S/ 0.00" step="0.01">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Descripción</label>
                                <textarea class="form-control" name="descripcion" rows="2" placeholder="Detalles de la transacción"></textarea>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha</label>
                                <input type="date" class="form-control" name="fecha" required>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Capital Distribution Chart
        const capitalCtx = document.getElementById('capitalChart').getContext('2d');
        const capitalChart = new Chart(capitalCtx, {
            type: 'doughnut',
            data: {
                labels: ['Capital Disponible', 'Capital en Empeños', 'Capital en Préstamos'],
                datasets: [{
                    data: [12850, 19300, 2000],
                    backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc'],
                    hoverBackgroundColor: ['#2e59d9', '#17a673', '#2c9faf'],
                    hoverBorderColor: "rgba(234, 236, 244, 1)",
                }],
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return `${context.label}: S/ ${context.raw.toLocaleString()}`;
                            }
                        }
                    }
                }
            }
        });

        // Monthly Flow Chart
        const flowCtx = document.getElementById('flowChart').getContext('2d');
        const flowChart = new Chart(flowCtx, {
            type: 'bar',
            data: {
                labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul'],
                datasets: [{
                    label: "Entradas",
                    backgroundColor: "#1cc88a",
                    hoverBackgroundColor: "#17a673",
                    data: [12500, 14000, 11500, 13200, 14800, 12600, 8750]
                },
                {
                    label: "Salidas",
                    backgroundColor: "#e74a3b",
                    hoverBackgroundColor: "#be2617",
                    data: [8500, 9200, 7800, 8900, 10200, 8700, 5330]
                }]
            },
            options: {
                maintainAspectRatio: false,
                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        ticks: {
                            callback: function (value) {
                                return 'S/ ' + value.toLocaleString();
                            }
                        },
                        grid: {
                            color: "rgb(234, 236, 244)"
                        }
                    }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return `${context.dataset.label}: S/ ${context.raw.toLocaleString()}`;
                            }
                        }
                    }
                }
            }
        });

        // Sample transaction type change
        document.getElementById('transactionType').addEventListener('change', function () {
            const categorySelect = document.getElementById('transactionCategory');
            if (this.value === 'ingreso') {
                categorySelect.innerHTML = `
                    <option value="">Seleccionar...</option>
                    <option value="empenio">Recogida de Empeño</option>
                    <option value="venta">Venta de Producto</option>
                    <option value="otro">Otro Ingreso</option>
                `;
            } else if (this.value === 'salida') {
                categorySelect.innerHTML = `
                    <option value="">Seleccionar...</option>
                    <option value="prestamo">Préstamo</option>
                    <option value="gasto">Gasto Operativo</option>
                    <option value="otro">Otra Salida</option>
                `;
            } else {
                categorySelect.innerHTML = '<option value="">Seleccionar...</option>';
            }
        });
    </script>
</body>

</html>