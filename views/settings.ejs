<%- include('partials/header', {title: 'Configuración - Sistema de Empeños', currentPage: 'settings'}) %>

<%- include('partials/sidebar', {currentPage: 'settings'}) %>

<div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-gray-800">Configuración</h1>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Control de Caja Diaria</h6>
                    <% if (saved) { %>
                        <span class="badge bg-success">Guardado</span>
                    <% } %>
                    <% if (error) { %>
                        <span class="badge bg-danger">Error</span>
                    <% } %>
                </div>
                <div class="card-body">
                    <% if (!isAdmin) { %>
                        <div class="alert alert-warning mb-0">
                            Solo el usuario administrador puede modificar la configuración de caja.
                        </div>
                    <% } else { %>
                        <form action="/settings/caja" method="POST" class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Saldo inicial (solo para el primer cierre)</label>
                                <input type="number" step="0.01" min="0" class="form-control" name="saldo_inicial_manual"
                                    value="<%= config.saldo_inicial_manual !== null ? config.saldo_inicial_manual : '' %>"
                                    placeholder="Ej: 1000.00">
                                <small class="text-muted">Se usa únicamente si aún no existe un cierre anterior.</small>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="cierreAutorizadoSwitch"
                                        name="cierre_autorizado" value="1" <%= config.cierre_autorizado ? 'checked' : '' %>>
                                    <label class="form-check-label" for="cierreAutorizadoSwitch">
                                        Autorizar botón "Cerrar Caja" en Flujo de Caja
                                    </label>
                                </div>
                                <small class="text-muted">Habilita el botón de cierre diario para los usuarios.</small>
                            </div>
                            <div class="col-12 d-flex justify-content-end gap-2">
                                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                            </div>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<%- include('partials/scripts', {currentPage: 'settings'}) %>
</body>
</html>