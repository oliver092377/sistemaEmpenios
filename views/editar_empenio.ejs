<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Empeño</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        form { max-width: 400px; margin: auto; }
        label { font-weight: bold; display: block; margin-top: 10px; }
        input, select { width: 100%; padding: 8px; margin-top: 5px; }
        #guardar {
            background-color: #4CAF50; 
            color: white; 
            padding: 10px; 
            margin-top: 15px; 
            border: none; 
            cursor: pointer; 
            width: 100%; 
        }
        #cancelar {
            background-color: red; 
            color: white; 
            padding: 10px; 
            margin-top: 15px; 
            border: none; 
            cursor: pointer; 
            width: 100%; 
        }

        button:hover { background-color: black; }
    </style>
</head>
<body>

    <h1>Editar Empeño</h1>
    
    <form action="/empenio/actualizar-empenio/<%= empenio.idEmpenios %>" method="POST">
        <label for="nombres">Nombres:</label>
        <input type="text" id="nombres" name="nombres" value="<%= empenio.Nombres_Cliente %>" required>

        <label for="apellidos">Apellidos:</label>
        <input type="text" id="apellidos" name="apellidos" value="<%= empenio.Apellidos_Cliente %>" required>

        <label for="artefacto">Artefacto:</label>
        <input type="text" id="artefacto" name="artefacto" value="<%= empenio.Artefacto %>" required>

        <label for="marca">Marca:</label>
        <input type="text" id="marca" name="marca" value="<%= empenio.Marca %>" required>

        <label for="fecha">Fecha:</label>
        <input type="date" id="fecha" name="fecha" value="<%= empenio.Fecha %>" required>

        <label for="monto">Monto:</label>
        <input type="number" id="monto" name="monto" value="<%= empenio.Monto %>" required>

        <label>Descripcion:</label>
        <textarea name="descripcion" rows="5" cols="54"><%= empenio.Detalles %></textarea>

        <label for="estado">Estado:</label>
        <select name="estado" id="estado" name="estado"  required>
            <option value="<%= empenio.Estado %>"><%= empenio.Estado %></option>
        </select>

        <label for="propietario">Propietario:</label>
        <select name="propietario" id="propietario" name="propietario"  required>
            <option value="<%= empenio.Propietario %>"><%= empenio.Propietario %></option>
        </select>

        <button type="submit" id="guardar">Guardar Cambios</button>
        <a href="/empenio"><button type="button" id="cancelar">Cancelar</button></a>
    </form>
    <script>
        // Obtiene el propietario actual
        var propietarioActual = "<%= empenio.Propietario %>";
        var estadoActual = "<%= empenio.Estado %>";
    
        // Lista de posibles propietarios
        var propietarios = ["Tienda", "Orlando", "Oscar", "Oliver"];
        var estados = ["Activo", "Recogido", "En venta", "Vendido"];

        // Filtrar para evitar repetidos
        var opcionesFiltradas1 = propietarios.filter(p => p !== propietarioActual);
        var opcionesFiltradas2 = estados.filter(p => p !== estadoActual);
    
        // Insertar las opciones en el select
        var select1 = document.getElementById("propietario");
        var select2 = document.getElementById("estado");
        opcionesFiltradas1.forEach(propietario => {
            var option = document.createElement("option");
            option.value = propietario;
            option.textContent = propietario;
            select1.appendChild(option);
        });
        opcionesFiltradas2.forEach(estado => {
            var option = document.createElement("option");
            option.value = estado;
            option.textContent = estado;
            select2.appendChild(option);
        });
    </script>

</body>
</html>
